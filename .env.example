# oiltank settings. Copy this file to .env and fill it in. .env is git-ignored, so secrets stay
# out of the repo.
#
# Every setting is OILTANK_<SECTION>_<KEY>. This file is the container's whole configuration:
# Docker Compose passes every line to it. When you run from a checkout, `uv run oiltank ...` reads
# .env from the current directory too, and variables set in your shell win over it. Leaving a value
# empty means "not set". Commented-out lines show the defaults.

# ---- Camera ------------------------------------------------------------------------------------
# A URL that returns one full-resolution JPEG per request. For go2rtc, use the frame API on the
# camera's main (4K) stream. Not the camera's own snapshot URL: that one is only 640x360.
OILTANK_CAMERA_URL=http://go2rtc.lan:1984/api/frame.jpeg?src=oil_tank
# Only if go2rtc's `api:` section sets a username and password. Never put them in the URL.
OILTANK_CAMERA_USERNAME=
OILTANK_CAMERA_PASSWORD=
# Each reading is a burst of frames, combined by median. The spacing should be at least the
# camera's keyframe interval, or go2rtc may hand back the same frame twice.
# OILTANK_CAMERA_BURST_FRAMES=5
# OILTANK_CAMERA_BURST_SPACING_S=2.0
# OILTANK_CAMERA_TIMEOUT_S=15
# OILTANK_CAMERA_RETRIES=3
# OILTANK_CAMERA_RETRY_BACKOFF_S=2.0
# OILTANK_CAMERA_VERIFY_TLS=true

# ---- MQTT (Home Assistant's broker; used from milestone M4) ----------------------------------
OILTANK_MQTT_HOST=homeassistant.lan
OILTANK_MQTT_PORT=1883
OILTANK_MQTT_USERNAME=oiltank
OILTANK_MQTT_PASSWORD=
# OILTANK_MQTT_TLS=false
# OILTANK_MQTT_CLIENT_ID=oiltank
# OILTANK_MQTT_TOPIC_PREFIX=oiltank
# OILTANK_MQTT_DISCOVERY_PREFIX=homeassistant

# ---- Home Assistant device (milestone M4) -----------------------------------------------------
# OILTANK_DEVICE_ID=oil_tank
# OILTANK_DEVICE_NAME=Oil Tank

# ---- Tank (milestone M5) ------------------------------------------------------------------------
# Usable capacity when the gauge reads F, in UNIT (gal or L).
OILTANK_TANK_CAPACITY=250
# OILTANK_TANK_UNIT=gal
# "Days left" counts down to this volume rather than to empty. For example, 26 gal is 10%.
# OILTANK_TANK_RESERVE=0

# ---- Service (milestone M5) ---------------------------------------------------------------------
# OILTANK_SERVICE_INTERVAL_MIN=15
# OILTANK_SERVICE_MIN_CONFIDENCE=0.5

# ---- Files and logging --------------------------------------------------------------------------
# Where calibration.yaml (and later the history and frame archive) live. Relative paths are relative
# to the working directory: the checkout when you run `uv run oiltank`, and / in the container. So
# the default, data, means ./data either way, which Compose mounts at /data.
# OILTANK_DATA_DIR=data
# OILTANK_LOG_LEVEL=INFO

# ---- Container ----------------------------------------------------------------------------------
# The container's timezone, for the timestamps on the gauge image.
TZ=America/New_York
