{
  "device": {
    "identifiers": [
      "oil_tank"
    ],
    "name": "Oil Tank",
    "manufacturer": "oiltank",
    "model": "Float gauge camera reader",
    "sw_version": "<version>"
  },
  "origin": {
    "name": "oiltank",
    "sw_version": "<version>"
  },
  "availability_topic": "oiltank/oil_tank/availability",
  "qos": 1,
  "components": {
    "level": {
      "platform": "sensor",
      "unique_id": "oil_tank_level",
      "name": "Level",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.level }}",
      "unit_of_measurement": "%",
      "state_class": "measurement",
      "suggested_display_precision": 0,
      "icon": "mdi:storage-tank"
    },
    "volume": {
      "platform": "sensor",
      "unique_id": "oil_tank_volume",
      "name": "Volume",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.volume }}",
      "device_class": "volume_storage",
      "unit_of_measurement": "gal",
      "state_class": "measurement",
      "suggested_display_precision": 0
    },
    "usage_rate": {
      "platform": "sensor",
      "unique_id": "oil_tank_usage_rate",
      "name": "Usage rate",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.usage_rate }}",
      "unit_of_measurement": "gal/d",
      "state_class": "measurement",
      "suggested_display_precision": 1,
      "icon": "mdi:fire"
    },
    "days_left": {
      "platform": "sensor",
      "unique_id": "oil_tank_days_left",
      "name": "Days left",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.days_left }}",
      "device_class": "duration",
      "unit_of_measurement": "d",
      "suggested_display_precision": 0,
      "icon": "mdi:calendar-clock"
    },
    "last_fill": {
      "platform": "sensor",
      "unique_id": "oil_tank_last_fill",
      "name": "Last fill",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.last_fill }}",
      "device_class": "timestamp",
      "icon": "mdi:tanker-truck"
    },
    "last_fill_volume": {
      "platform": "sensor",
      "unique_id": "oil_tank_last_fill_volume",
      "name": "Last fill amount",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.last_fill_volume }}",
      "device_class": "volume",
      "unit_of_measurement": "gal",
      "suggested_display_precision": 0
    },
    "gauge": {
      "platform": "image",
      "unique_id": "oil_tank_gauge",
      "name": "Gauge",
      "image_topic": "oiltank/oil_tank/image",
      "content_type": "image/jpeg"
    },
    "read_now": {
      "platform": "button",
      "unique_id": "oil_tank_read_now",
      "name": "Read now",
      "command_topic": "oiltank/oil_tank/cmd/read",
      "payload_press": "PRESS",
      "icon": "mdi:refresh"
    },
    "problem": {
      "platform": "binary_sensor",
      "unique_id": "oil_tank_problem",
      "name": "Problem",
      "device_class": "problem",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ 'ON' if value_json.problem else 'OFF' }}",
      "json_attributes_topic": "oiltank/oil_tank/state",
      "json_attributes_template": "{{ {'reason': value_json.reason} | tojson }}"
    },
    "confidence": {
      "platform": "sensor",
      "unique_id": "oil_tank_confidence",
      "name": "Confidence",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ (value_json.confidence * 100) | round(0) }}",
      "unit_of_measurement": "%",
      "state_class": "measurement",
      "suggested_display_precision": 0,
      "entity_category": "diagnostic"
    },
    "last_reading": {
      "platform": "sensor",
      "unique_id": "oil_tank_last_reading",
      "name": "Last reading",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.ts }}",
      "device_class": "timestamp",
      "entity_category": "diagnostic"
    },
    "position": {
      "platform": "sensor",
      "unique_id": "oil_tank_position",
      "name": "Gauge position",
      "state_topic": "oiltank/oil_tank/state",
      "value_template": "{{ value_json.t }}",
      "suggested_display_precision": 3,
      "entity_category": "diagnostic",
      "enabled_by_default": false
    }
  }
}
